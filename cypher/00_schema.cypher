// Helium graph schema for Neo4j. Run once per tenant database (and once on `commons`); every statement
// carries IF NOT EXISTS so re-running is a no-op. hiveboard.schema.ensure_schema runs every line below, then the
// unique `id` constraints for hiveboard.schema.UNIQUE_ID_LABELS (a constraint carries its own index, so no range
// index on `id` appears here), then CALL db.awaitIndexes so vector and full-text indexes are ONLINE before use.
// One statement per line; comment lines start with //.

// Range indexes (exact match, ranges, IN)
CREATE INDEX person_email IF NOT EXISTS FOR (n:Person) ON (n.email)
CREATE INDEX meeting_started_at IF NOT EXISTS FOR (n:Meeting) ON (n.started_at)
CREATE INDEX episode_t_occurred IF NOT EXISTS FOR (n:Episode) ON (n.t_occurred)
CREATE INDEX episode_source_kind IF NOT EXISTS FOR (n:Episode) ON (n.source_kind)
CREATE INDEX entity_name IF NOT EXISTS FOR (n:Entity) ON (n.name)
CREATE INDEX fact_status IF NOT EXISTS FOR (n:Fact) ON (n.status)
CREATE INDEX fact_valid_from IF NOT EXISTS FOR (n:Fact) ON (n.valid_from)
CREATE INDEX fact_valid_to IF NOT EXISTS FOR (n:Fact) ON (n.valid_to)
CREATE INDEX fact_key IF NOT EXISTS FOR (n:Fact) ON (n.key)
CREATE INDEX commitment_status IF NOT EXISTS FOR (n:Commitment) ON (n.status)
CREATE INDEX commitment_due_at IF NOT EXISTS FOR (n:Commitment) ON (n.due_at)
CREATE INDEX task_status IF NOT EXISTS FOR (n:Task) ON (n.status)
CREATE INDEX capability_name IF NOT EXISTS FOR (n:Capability) ON (n.name)
CREATE INDEX skill_status IF NOT EXISTS FOR (n:Skill) ON (n.status)
CREATE INDEX snapshot_tenant IF NOT EXISTS FOR (n:Snapshot) ON (n.tenant)
CREATE INDEX tenant_slug IF NOT EXISTS FOR (n:Tenant) ON (n.slug)
CREATE INDEX turn_session IF NOT EXISTS FOR (n:Turn) ON (n.session_id)

// Full-text (Lucene). hiveboard.memory.sanitize_fulltext turns user text into `a OR b OR c` of plain tokens.
CREATE FULLTEXT INDEX episode_text IF NOT EXISTS FOR (n:Episode) ON EACH [n.text]
CREATE FULLTEXT INDEX fact_text IF NOT EXISTS FOR (n:Fact) ON EACH [n.text]
CREATE FULLTEXT INDEX decision_text IF NOT EXISTS FOR (n:Decision) ON EACH [n.text]

// Vector (HNSW). EmbeddingGemma = 768 dims, normalized -> cosine. db.index.vector.queryNodes returns a SIMILARITY in
// [0, 1] ((1 + cos) / 2); the queries convert it to the cosine distance 2 * (1 - score) the ranking was specified in.
CREATE VECTOR INDEX episode_embedding IF NOT EXISTS FOR (n:Episode) ON (n.embedding) OPTIONS {indexConfig: {`vector.dimensions`: 768, `vector.similarity_function`: 'cosine'}}
CREATE VECTOR INDEX fact_embedding IF NOT EXISTS FOR (n:Fact) ON (n.embedding) OPTIONS {indexConfig: {`vector.dimensions`: 768, `vector.similarity_function`: 'cosine'}}
CREATE VECTOR INDEX skill_embedding IF NOT EXISTS FOR (n:Skill) ON (n.embedding) OPTIONS {indexConfig: {`vector.dimensions`: 768, `vector.similarity_function`: 'cosine'}}
CREATE VECTOR INDEX entity_embedding IF NOT EXISTS FOR (n:Entity) ON (n.embedding) OPTIONS {indexConfig: {`vector.dimensions`: 768, `vector.similarity_function`: 'cosine'}}

// Unique constraints are generated by hiveboard.schema from UNIQUE_ID_LABELS:
// CREATE CONSTRAINT person_id IF NOT EXISTS FOR (n:Person) REQUIRE n.id IS UNIQUE
// ... same for Meeting, EmailThread, Episode, Entity, Fact, Decision, Commitment, Task, Agent, Skill, Step, Artifact,
// Snapshot, WorkItem, Document, FollowUpDraft.
