# Helium runtime
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=helium-dev-password
# Aura Free: neo4j+s://<instance-id>.databases.neo4j.io and the database name shown in Aura (usually neo4j).
# Set NEO4J_SINGLE_DATABASE=true to skip Enterprise-only database/user/CDC setup.
NEO4J_DATABASE=
NEO4J_SINGLE_DATABASE=false
HELIUM_TENANT_RW_PASSWORD=change-me-rw
HELIUM_TENANT_RO_PASSWORD=change-me-ro
# Events: memory (local fallback) or cdc (Neo4j Enterprise)
HELIUM_EVENTS=cdc

# Model providers: gemini | openrouter | ollama | anthropic | fake
# anthropic: LLM_MODEL=claude-opus-5-5 (prompt caching is automatic)
LLM_BACKEND=ollama
LLM_MODEL=gemma4:e4b
LLM_MODEL_SMALL=gemma4:e4b
GEMINI_API_KEY=
GEMINI_API_KEY_2=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# anthropic only: effort low | medium | high | xhigh | max | none; cache TTL 5m | 1h
LLM_EFFORT=
LLM_CACHE_TTL=5m
OLLAMA_BASE_URL=http://localhost:11434/v1

# Embeddings: onnx | gemini | fake
EMBED_BACKEND=onnx
EMBED_MODEL=onnx-community/embeddinggemma-300m-ONNX
HF_HOME=~/.cache/huggingface

# Optional speech to text
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3

# Helium API and web
API_HOST=0.0.0.0
API_PORT=8081
CORS_ORIGINS=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:8081
